# /etc/mikrotik-manager.env – Einstellungen für den systemd-Dienst
# (bei Docker dieselben Namen unter environment: in docker-compose.yml)

LISTEN=:8080
TZ=Europe/Berlin

# Weboberfläche: Benutzer/Passwort. Leer = beim ersten Start wird ein
# Passwort erzeugt und nach /var/lib/mikrotik-manager/web-password.txt geschrieben.
#WEB_USER=admin
#WEB_PASSWORD=

# Zusätzliche Netze per API-Port-Scan durchsuchen (für Geräte, deren MNDP hier
# nicht ankommt, z. B. andere VLANs). Leer = nur MNDP im eigenen Segment.
#SCAN_CIDRS=192.168.1.0/24, 10.0.20.0/24

# API-SSL (Port 8729) statt Klartext-API (8728) verwenden
#API_TLS=false

# Tägliches Backup aller Geräte auf den Manager (Ortszeit hh:mm), "off" = aus
#BACKUP_TIME=04:00

# Selbst-Update über GitHub-Releases; „off“ = keine Prüfung
#UPDATE_REPO=peterhagelhof7-cmd/mikrotik-manager
# Neue Releases ohne Klick installieren (sonst Knopf in der Weboberfläche)
#AUTO_UPDATE=false

# Wie oft alle Geräte ausgelesen werden
#POLL_INTERVAL=5m
